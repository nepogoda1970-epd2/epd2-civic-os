{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epd2.infra01.deployment-manifest/1",
  "title": "EPD2 integrated deployment manifest (FIR-REL-001 foundation)",
  "description": "One approved immutable deployment manifest per integrated contour. The governing invariant is 'running combination == one approved deployment manifest', NOT 'all services must be identical version'. Mixed-version rolling deployment is representable only where the compatibility matrix explicitly permits the exact combination; absence of compatibility evidence means the combination is not deployable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "environment",
    "components",
    "compatibility",
    "sovereignty_profile",
    "approval"
  ],
  "properties": {
    "schema": { "const": "epd2.infra01.deployment-manifest/1" },
    "manifest_id": { "type": "string", "minLength": 8 },
    "created_at": { "type": "string" },
    "environment": {
      "type": "string",
      "enum": ["development", "test", "staging", "production", "trial-preview"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "artifact_digest",
          "source_revision",
          "dependency_lock_digest",
          "contract_versions",
          "configuration_version",
          "migration_set"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "dependency_lock_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "contract_versions": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "configuration_version": { "type": "string", "minLength": 1 },
          "migration_set": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["uniform", "mixed-by-declared-matrix"]
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["components", "evidence"],
            "properties": {
              "components": {
                "type": "object",
                "minProperties": 2,
                "additionalProperties": { "type": "string" }
              },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sovereignty_profile": {
      "type": "object",
      "description": "FIR-INFRA-SOV-001 machine-readable profile fields. Provider choice != trust assumption; unknown critical infrastructure state fails closed, so every field is required and 'UNDECIDED' must be declared explicitly rather than omitted.",
      "additionalProperties": false,
      "required": [
        "region",
        "jurisdiction",
        "tenancy_isolation_class",
        "data_residency_policy",
        "operator_access_model",
        "key_custody_model",
        "provider_role",
        "backup_location",
        "trust_assumptions"
      ],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "tenancy_isolation_class": {
          "type": "string",
          "enum": [
            "shared",
            "dedicated-virtual",
            "dedicated-physical",
            "UNDECIDED"
          ]
        },
        "data_residency_policy": { "type": "string", "minLength": 1 },
        "operator_access_model": { "type": "string", "minLength": 1 },
        "key_custody_model": { "type": "string", "minLength": 1 },
        "provider_role": { "type": "string", "minLength": 1 },
        "backup_location": { "type": "string", "minLength": 1 },
        "trust_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority"],
      "properties": {
        "state": { "type": "string", "enum": ["draft", "approved", "revoked"] },
        "authority": { "type": "string", "minLength": 1 },
        "record": { "type": "string" }
      }
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
