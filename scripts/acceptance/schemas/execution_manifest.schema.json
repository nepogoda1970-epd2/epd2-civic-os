{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epd2.infra01.execution-manifest/1",
  "title": "EPD2 INFRA-01 execution manifest",
  "description": "Machine-readable record of one canonical acceptance execution (assignment section 5). Serialized canonically (UTF-8, sorted keys, compact separators, trailing newline) and sealed with manifest_sha256 computed over the document with that field excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "harness_name",
    "harness_version",
    "identity",
    "tools",
    "registry",
    "results",
    "finished_at",
    "freeze_tree_digest",
    "final_archive_sha256",
    "evidence_files",
    "unresolved",
    "verdict",
    "manifest_sha256"
  ],
  "properties": {
    "schema": { "const": "epd2.infra01.execution-manifest/1" },
    "harness_name": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "git_commit",
        "git_tree",
        "git_dirty",
        "dirty_paths",
        "repository_version",
        "canon_version",
        "versions",
        "lock_hashes",
        "platform",
        "python_version",
        "harness_name",
        "harness_version",
        "workflow",
        "candidate_archive_sha256",
        "problems"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 8 },
        "started_at": { "type": "string" },
        "git_commit": { "type": "string", "minLength": 7 },
        "git_tree": { "type": "string", "minLength": 7 },
        "git_dirty": { "type": "boolean" },
        "dirty_paths": { "type": "array", "items": { "type": "string" } },
        "repository_version": { "type": "string", "minLength": 1 },
        "canon_version": { "type": "string", "minLength": 1 },
        "versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "lock_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "platform": { "type": "string" },
        "python_version": { "type": "string" },
        "harness_name": { "type": "string" },
        "harness_version": { "type": "string" },
        "workflow": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "candidate_archive_sha256": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "problems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tools": { "type": "object", "additionalProperties": { "type": "string" } },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "registry_version",
        "registry_sha256",
        "mandatory_check_ids"
      ],
      "properties": {
        "schema": { "type": "string" },
        "registry_version": { "type": "string" },
        "registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mandatory_check_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "stage_id",
          "state",
          "detector_codes",
          "exit_code",
          "started_at",
          "finished_at",
          "log_file",
          "log_sha256",
          "test_counts",
          "detail"
        ],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "stage_id": { "type": "string", "minLength": 1 },
          "state": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE_GOVERNED"]
          },
          "detector_codes": { "type": "array", "items": { "type": "string" } },
          "exit_code": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
          "started_at": { "type": "string" },
          "finished_at": { "type": "string" },
          "log_file": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
          "log_sha256": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            ]
          },
          "test_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "detail": { "type": "string" }
        }
      }
    },
    "finished_at": { "type": "string" },
    "freeze_tree_digest": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "final_archive_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "evidence_files": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
