-    executed = value == key
-    handler._reply(200, {"operation_key": key, "executed": executed, "duplicate": not executed})
-    state.record(
-        "consequential-effect",
-        {
-            "operation_key": key,
-            "executed": executed,
-            "duplicate": not executed,
-            "generation": state.recovery_generation,
