-<script>
-const SESSION = new URLSearchParams(location.search).get('session') || '';
-let ME=null, CAT=null, CSRF='', TICKET=null, RECORDS=[];
-const log=(m)=>{const l=document.getElementById('log');l.textContent=(new Date().toISOString()+' '+m+'\n')+l.textContent;};
-// Every server value is HTML-escaped at ingestion; the page only ever renders escaped data.
-const esc=(v)=>typeof v==='string'?v.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])):Array.isArray(v)?v.map(esc):(v&&typeof v==='object')?Object.fromEntries(Object.entries(v).map(([k,x])=>[esc(k),esc(x)])):v;
-async function api(method,path,body){
-  const h={'Content-Type':'application/json','X-EPD2-Session':SESSION};
-  if(CSRF) h['X-EPD2-CSRF']=CSRF;
-  const r=await fetch(path,{method,headers:h,body:body?JSON.stringify(body):undefined});
-  const j=esc(await r.json());
-  log(method+' '+path+' -> '+r.status+' '+JSON.stringify(j).slice(0,320));
-  return {status:r.status,json:j};
-}
-async function apiWithHeaders(method,path){
-  const h={'Content-Type':'application/json','X-EPD2-Session':SESSION};
-  const r=await fetch(path,{method,headers:h});
-  const j=esc(await r.json());
-  log(method+' '+path+' -> '+r.status+' '+JSON.stringify(j).slice(0,320));
-  return {status:r.status,json:j,csrf:r.headers.get('X-EPD2-CSRF')};
-}
-function badge(v,extra){return '<span class="badge '+v+' '+(extra||'')+'">'+v+'</span>';}
-function scope(){return {region_id:document.getElementById('q-region').value,org_id:document.getElementById('q-org').value,unit_id:document.getElementById('q-unit').value};}
-function has(right){return !!(ME&&ME.usable&&ME.mandates.some(m=>m.usable&&m.rights.includes(right)));}
-function why(right){
-  if(!ME) return 'no session';
-  if(!ME.usable) return 'session '+ME.session_state;
-  if(!ME.mandates.length) return 'no oversight mandate: nothing is visible and nothing may be reviewed';
-  if(!has(right)) return 'no '+right+' in any mandated scope (visibility is not authorization)';
-  return '';
-}
