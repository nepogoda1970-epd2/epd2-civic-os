-  document.getElementById('p-purpose').innerHTML=Object.keys(CAT.export_purposes).map(p=>'<option value="'+p+'">'+p+'</option>').join('');
-  document.getElementById('q-limit').max=CAT.bounds.query_limit;
-  document.getElementById('g-depth').max=CAT.bounds.graph_depth;
-  const me=await apiWithHeaders('GET','/audit/v1/me');
-  // The CSRF token arrives as a response header, never in a read body.
-  if(me.status===200){ME=me.json;CSRF=me.csrf||'';}
-  // The scope offered is the mandate's own scope. The page proposes nothing
