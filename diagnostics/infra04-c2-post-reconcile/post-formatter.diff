-  if(ME&&ME.mandates.length){
-    const m=ME.mandates[0];
-    const parts=String(m.scope).split(':');
-    if(!document.getElementById('q-region').value) document.getElementById('q-region').value=parts[0]||'';
-    if(!document.getElementById('q-org').value) document.getElementById('q-org').value=parts[1]||'';
-    if(!document.getElementById('q-unit').value) document.getElementById('q-unit').value=parts[2]||'';
-  }
-  document.getElementById('who').innerHTML=me.status===200
-    ?('<span>'+ME.principal_id+'</span> '+(ME.mandates.length?badge('MANDATED'):badge('NO_MANDATE','ro'))+' '+badge('NOT_AN_OPERATOR'))
-    :badge('NO_SESSION','ro');
-  updateWhy();await loadCases();
-}
-function updateWhy(){
-  document.getElementById('q-why').textContent=why('AUDIT.READ')||'exact scope required: every query is anchored on region + organization + oversight unit';
-  document.getElementById('c-why').textContent=why('AUDIT.REVIEW')||'a case always names the exact evidence it reviews';
-  const act=document.getElementById('p-act');
-  const right=act.options[act.selectedIndex].dataset.right;
-  document.getElementById('p-why').textContent=why(right)||'prepare captures authority and evidence digests; the act is re-authorized at commit time';
-  document.getElementById('q-go').disabled=!!why('AUDIT.READ');
-  document.getElementById('c-open').disabled=!!why('AUDIT.REVIEW');
