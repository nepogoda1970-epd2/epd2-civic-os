    "max_exception_days": 120,
    "release_blocking_rule": "ANY_FINDING_WITHOUT_GOVERNED_EXCEPTION",
    "scan_binding": "scan evidence must record the exact lockfile SHA-256 digests it scanned; evidence for other lockfile digests is stale and cannot authorize a release",
    "scanners_required": [
