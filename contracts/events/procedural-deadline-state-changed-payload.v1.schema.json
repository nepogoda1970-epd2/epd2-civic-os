{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epd2.example/contracts/events/procedural-deadline-state-changed-payload.v1.schema.json",
  "title": "procedural_deadline.state_changed event payload (v1)",
  "description": "PACK-09, ADR-041. Produced by epd2_compliance_service.events. Minimum payload only: identifiers, enum values, timestamps and reason codes. It never carries a document or its bytes, a ballot/vote/tally/delegation reference, an authentication secret, an identity/eID/KYC attribute, a free-text case narrative, or the name of any natural person (PACK-09 required invariants 1, 11, 12 and 13). Carries the LAST history entry's before/after due times plus its sequence number, so a consumer can detect a gap without this service ever re-sending (or being able to rewrite) earlier entries. timezone is the deadline's own explicit IANA zone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deadline_id",
    "case_id",
    "organization_id",
    "deadline_code",
    "timezone",
    "status",
    "sequence",
    "event_type",
    "due_at_before",
    "due_at_after",
    "remaining_seconds",
    "reason_code",
    "superseded_by_deadline_id",
    "recorded_at"
  ],
  "properties": {
    "deadline_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "deadline_code": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "suspended",
        "satisfied",
        "expired",
        "escalated",
        "cancelled"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "started",
        "suspended",
        "resumed",
        "extended",
        "satisfied",
        "expired",
        "escalated",
        "cancelled",
        "superseded"
      ]
    },
    "due_at_before": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "due_at_after": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "remaining_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "superseded_by_deadline_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
