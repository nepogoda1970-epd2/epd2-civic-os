{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epd2.example/contracts/events/ai-processing-record-payload.v1.schema.json",
  "title": "ai.* event payload (v1)",
  "description": "docs/canonical/TZ-00-domain-event-canon.md, section 20.12 (corrected/expanded by canon 0.5.0, ADR-023). Produced by epd2_ai_processing_service.events.ai_processing_record_public_payload, shared verbatim by every ai.* event_type builder in that module (ai.processing_requested, ai.input_prepared, ai.output_created, ai.processing_failed, ai.processing_rejected_by_policy, ai.processing_record_superseded, ai.output_reviewed, ai.output_accepted, ai.output_corrected, ai.output_rejected, ai.review_outcome_superseded) - verified by reading events.py, every builder calls the shared payload function and differs only in event_type (plus, for the two superseded events, one extra superseded_by_ai_processing_record_id field). Deliberately omits human_reviewer_reference entirely (mirrors governance-service's own omission of every *_role_id field from its event payloads, canon 19b.1/19b.3/19b.4 precedent) - no external event payload in this pack ever reveals which actor reviewed a given record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ai_processing_record_id",
    "purpose_code",
    "target_type",
    "target_id",
    "input_version",
    "model_provider",
    "model_name",
    "model_version",
    "prompt_template_version",
    "output_reference",
    "created_at",
    "human_review_status",
    "correction_reference",
    "processing_status",
    "supersedes_ai_processing_record_id",
    "external_provider_flag",
    "reason_codes",
    "redaction_manifest",
    "disclosure_required",
    "disclosure_package_reference",
    "disclosure_receipt_reference"
  ],
  "properties": {
    "ai_processing_record_id": { "type": "string", "format": "uuid" },
    "purpose_code": { "type": "string", "minLength": 1 },
    "target_type": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "format": "uuid" },
    "input_version": { "type": "string", "minLength": 1 },
    "model_provider": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "prompt_template_version": { "type": "string", "minLength": 1 },
    "output_reference": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "human_review_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "approved_with_changes",
        "rejected",
        "superseded"
      ]
    },
    "correction_reference": { "type": ["string", "null"] },
    "processing_status": {
      "type": "string",
      "enum": [
        "requested",
        "input_prepared",
        "processing",
        "completed",
        "failed",
        "rejected_by_policy"
      ]
    },
    "supersedes_ai_processing_record_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "deployment_version": { "type": ["string", "null"] },
    "system_policy_version": { "type": ["string", "null"] },
    "generation_settings": { "type": ["object", "null"] },
    "processing_region": { "type": ["string", "null"] },
    "data_retention_mode": { "type": ["string", "null"] },
    "external_provider_flag": { "type": "boolean" },
    "input_hash": { "type": ["string", "null"] },
    "output_hash": { "type": ["string", "null"] },
    "confidence_score": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "uncertainty_indicator": { "type": ["string", "null"] },
    "explanation_reference": { "type": ["string", "null"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "redaction_manifest": { "type": ["object", "null"] },
    "disclosure_required": { "type": "boolean" },
    "disclosure_package_reference": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "disclosure_receipt_reference": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "superseded_by_ai_processing_record_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
