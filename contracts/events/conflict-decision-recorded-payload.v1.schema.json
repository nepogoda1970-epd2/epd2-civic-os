{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epd2.example/contracts/events/conflict-decision-recorded-payload.v1.schema.json",
  "title": "membership.conflict_decision_recorded event payload (v1)",
  "description": "docs/canonical/TZ-00-domain-event-canon.md, section 19d.11 (canon-0.6.0, PACK-07, ADR-030). Produced by epd2_membership_service.events.build_conflict_decision_recorded_event - the authorized human decision resolving a ConflictAssessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflict_assessment_id",
    "status",
    "incompatibility_level",
    "decision_authority_reference"
  ],
  "properties": {
    "conflict_assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "resolved_no_conflict",
        "resolved_conditional",
        "resolved_incompatible",
        "appealed",
        "overturned",
        "expired_reevaluation_due"
      ]
    },
    "incompatibility_level": {
      "type": "string",
      "enum": [
        "none",
        "disclosed_no_conflict",
        "conditional_restriction",
        "incompatible"
      ]
    },
    "decision_authority_reference": {
      "type": ["string", "null"],
      "format": "uuid"
    }
  }
}
