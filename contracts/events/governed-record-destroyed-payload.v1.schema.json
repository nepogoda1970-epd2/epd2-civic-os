{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epd2.example/contracts/events/governed-record-destroyed-payload.v1.schema.json",
  "title": "governed_record.destroyed event payload (v1)",
  "description": "PACK-09, ADR-039. Produced by epd2_compliance_service.events. Minimum payload only: identifiers, enum values, timestamps and reason codes. It never carries a document or its bytes, a ballot/vote/tally/delegation reference, an authentication secret, an identity/eID/KYC attribute, a free-text case narrative, or the name of any natural person (PACK-09 required invariants 1, 11, 12 and 13). Carries the evidence identifier and its opaque digest - never the destroyed content or any reconstruction of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "organization_id",
    "evidence_id",
    "authorization_id",
    "disposition_action",
    "evidence_digest",
    "executed_at",
    "retention_policy_id",
    "retention_policy_version",
    "recorded_at"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "authorization_id": {
      "type": "string",
      "format": "uuid"
    },
    "disposition_action": {
      "type": "string",
      "enum": ["delete", "anonymize", "archive", "review"]
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_policy_id": {
      "type": "string",
      "format": "uuid"
    },
    "retention_policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
