{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epd2.example/contracts/events/legal-case-reopened-payload.v1.schema.json",
  "title": "legal_case.reopened payload (v1)",
  "description": "Wire payload of `legal_case.reopened`. Reopening produces a NEW case that points at the prior one; the prior case stays closed and its closure reason is not erased. No field in this payload carries an identity attribute, a global person identifier, a party or authority handle, a document or its bytes, message content, an authentication secret, or any ballot/vote/tally/delegation reference (PACK-09 required invariants 1, 11, 12 and 13; Framework 0.8.1 section 11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_kind",
    "case_version",
    "legal_case_id",
    "organization_id",
    "prior_case_id",
    "reason_code",
    "recorded_at",
    "reopened_at",
    "reopened_from_case_id",
    "sequence",
    "status"
  ],
  "properties": {
    "case_kind": {
      "type": "string"
    },
    "case_version": {
      "type": "integer"
    },
    "legal_case_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "prior_case_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "reason_code": {
      "type": ["string", "null"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "reopened_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reopened_from_case_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "sequence": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    }
  }
}
