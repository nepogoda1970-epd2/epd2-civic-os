{
  "name": "epd2-civic-os",
  "version": "0.1.0",
  "private": true,
  "description": "EPD2 Civic OS monorepo workspace root (infrastructure skeleton, no business logic)",
  "workspaces": [
    "packages/typescript/epd2-types",
    "frontend/web-shell",
    "frontend/voting-client",
    "frontend/representative-workspace"
  ],
  "scripts": {
    "format:check": "prettier --check packages/typescript/epd2-types frontend/web-shell frontend/voting-client frontend/representative-workspace",
    "format": "prettier --write packages/typescript/epd2-types frontend/web-shell frontend/voting-client frontend/representative-workspace"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
